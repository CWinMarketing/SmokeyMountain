# Root-level reference for docker-compose.yml. Copy to .env and fill in as needed.
# All values here have safe local-dev defaults baked into docker-compose.yml;
# you only need a real .env for optional integrations (Stripe) or to change ports/passwords.

# --- Postgres ---
POSTGRES_DB=winr
POSTGRES_USER=winr
POSTGRES_PASSWORD=winr_dev_password

# --- Medusa backend ---
JWT_SECRET=dev_jwt_secret_change_me
COOKIE_SECRET=dev_cookie_secret_change_me
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9001
AUTH_CORS=http://localhost:8000,http://localhost:9001

# Optional: leave blank to use the manual/COD payment provider only.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Storefront ---
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_KEY=
# Set after seeding: printed by the seed script, or read from Medusa Admin > Settings > API Key Management.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
